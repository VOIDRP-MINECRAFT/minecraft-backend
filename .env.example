APP_NAME=VoidRP Account API
API_V1_PREFIX=/api/v1
APP_ENV=development
# DEBUG also turns on SQLAlchemy echo (logs every SQL query) and FastAPI debug
# tracebacks — keep it false in production to avoid log spam.
DEBUG=false

DATABASE_URL=postgresql+psycopg://voidrp:password@localhost:5432/voidrp_accounts

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_TOKEN_EXPIRE_HOURS=24

CORS_ALLOW_ORIGINS=["http://localhost:5175","https://void-rp.ru","https://www.void-rp.ru"]
EASYDONATE_SHOP_KEY=
EASYDONATE_SERVER_ID=

PLAY_TICKET_EXPIRE_MINUTES=720
GAME_AUTH_SHARED_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_FOR_GAME_BRIDGE
ADMIN_API_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET

LAUNCHER_HMAC_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_FOR_LAUNCHER_PROOF

# Email: "logging" prints to stdout (dev), "resend" sends via Resend API.
EMAIL_BACKEND=logging
RESEND_API_KEY=
EMAIL_FROM=VoidRP <noreply@mail.void-rp.ru>
PUBLIC_API_BASE_URL=https://api.void-rp.ru
WEBSITE_BASE_URL=https://void-rp.ru

MEDIA_PUBLIC_MOUNT_PATH=/media
MEDIA_PUBLIC_BASE_URL=https://api.void-rp.ru/media
MEDIA_STORAGE_ROOT=/home/mironoouv/minecraft/minecraft_backend/media

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=voidrp
REDIS_DEFAULT_TTL_SECONDS=30

MINECRAFT_SERVER_HOST=127.0.0.1
MINECRAFT_SERVER_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=
WEBGUI_TOKEN_SECRET_BASE64=

# News auto-posting to Telegram. One global bot for all servers: create it via
# @BotFather, add it as ADMIN to the supergroup/channel (with "Manage Topics" if
# using forum topics), paste the token here. Per-server destinations
# (telegram_targets: chat_id + topic thread_id) and Discord webhook URLs are set
# in the admin panel (Серверы), NOT here. Empty = Telegram posting off.
TELEGRAM_BOT_TOKEN=

# Outbound HTTP(S) proxy for external calls (Telegram/Discord). This host has no
# direct egress — external requests must go through the local proxy. Empty = direct.
OUTBOUND_PROXY_URL=http://127.0.0.1:8118
